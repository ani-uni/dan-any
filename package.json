{
  "name": "@dan-uni/dan-any",
  "version": "2.2.4",
  "description": "A danmaku transformer lib, supporting danmaku from different platforms.",
  "keywords": [
    "bangumi",
    "danmaku"
  ],
  "homepage": "https://github.com/ani-uni/dan-any#readme",
  "bugs": {
    "url": "https://github.com/ani-uni/dan-any/issues"
  },
  "license": "LGPL-3.0-or-later",
  "author": "rinne",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani-uni/dan-any.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./adapters": "./dist/adapters.js",
    "./core": "./dist/core.js",
    "./core/db/schema": "./dist/core/db/schema.js",
    "./core/db/utils": "./dist/core/db/utils.js",
    "./core/main": "./dist/core/main.js",
    "./core/main/drizzle": "./dist/core/main/drizzle.js",
    "./core/main/pure": "./dist/core/main/pure.js",
    "./plugins": "./dist/plugins.js",
    "./utils": "./dist/utils.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "buf": "buf generate",
    "db:generate": "drizzle-kit generate && bun ./scripts/compile-migrations.ts",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run buf && vp run db:generate && vp run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@electric-sql/pglite": "^0.5.2",
    "@electric-sql/pglite-tools": "^0.4.2",
    "@noble/hashes": "^2.2.0",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.8.0",
    "json-bigint": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.3",
    "@bufbuild/buf": "^1.70.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^25.9.3",
    "@typescript/native-preview": "^7.0.0-dev.20260611.2",
    "@vitest/ui": "^4.1.8",
    "bumpp": "^11.1.0",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^1.0.0-rc.4-ca0f029",
    "protobufjs": "^8.6.3",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.14",
  "inlinedDependencies": {
    "type-fest": "5.7.0"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}