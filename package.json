{
  "name": "@dan-uni/dan-any",
  "version": "2.3.9",
  "description": "A danmaku transformer lib, supporting danmaku from different platforms.",
  "keywords": [
    "bangumi",
    "danmaku"
  ],
  "homepage": "https://github.com/ani-uni/dan-any#readme",
  "bugs": {
    "url": "https://github.com/ani-uni/dan-any/issues"
  },
  "license": "LGPL-3.0-or-later",
  "author": "rinne",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani-uni/dan-any.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "import": "./dist/adapters.mjs",
      "require": "./dist/adapters.cjs"
    },
    "./core": {
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./core/db/schema": {
      "import": "./dist/core/db/schema.mjs",
      "require": "./dist/core/db/schema.cjs"
    },
    "./core/db/utils": {
      "import": "./dist/core/db/utils.mjs",
      "require": "./dist/core/db/utils.cjs"
    },
    "./core/main": {
      "import": "./dist/core/main.mjs",
      "require": "./dist/core/main.cjs"
    },
    "./core/main/drizzle": {
      "import": "./dist/core/main/drizzle.mjs",
      "require": "./dist/core/main/drizzle.cjs"
    },
    "./core/main/pure": {
      "import": "./dist/core/main/pure.mjs",
      "require": "./dist/core/main/pure.cjs"
    },
    "./plugins": {
      "import": "./dist/plugins.mjs",
      "require": "./dist/plugins.cjs"
    },
    "./utils": {
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "buf": "buf generate",
    "db:generate": "drizzle-kit generate && bun ./scripts/compile-migrations.ts",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run buf && vp run db:generate && vp run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-tools": "^0.4.8",
    "@noble/hashes": "^2.4.0",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.1",
    "json-bigint": "^1.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^26.4.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/ui": "4.1.11",
    "bumpp": "^12.2.2",
    "bun-types": "^1.4.0",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "protobufjs": "^8.8.0",
    "type-fest": "^5.9.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.0",
  "inlinedDependencies": {
    "type-fest": "5.9.0"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
